# ─────────────────────────────────────────────────────────────────
# SSDT Frontend – Environment Variables
# Copy this file to .env for local development.
# In CI/CD, inject these as GitHub Actions secrets / environment vars.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────

# Base URL of the backend API (ALB DNS or custom domain in production).
# Leave unset in local dev to fall back to http://localhost:3001.
# Example: https://api.yourdomain.com
REACT_APP_API_URL=

# Google OAuth Client ID (public – safe to include in frontend builds).
# Must match the client ID configured in backend Secrets Manager.
REACT_APP_GOOGLE_CLIENT_ID=
