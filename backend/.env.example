# MongoDB Atlas Connection (must use mongodb+srv:// — local MongoDB is not supported)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/virustotal-scanner?retryWrites=true&w=majority

# JWT Secret (generate a random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# PageSpeed Insights API Key
PSI_API_KEY=your_pagespeed_insights_api_key_here

# Gemini Model Configuration
# Pro: deep analysis, final reports, vulnerability reasoning (higher cost/latency)
GEMINI_MODEL_PRO=gemini-2.5-pro
# Flash: formatting, translation, summaries (low latency, cost-efficient)
GEMINI_MODEL_FLASH=gemini-2.5-flash

# ── Local development: Gemini AI Studio API key ───────────────────────────────
# Set this on your local machine to use AI Studio instead of Vertex AI + WIF.
# Get a key at https://aistudio.google.com/app/apikey
# On ECS Fargate this variable is NOT set — production always uses Vertex AI + WIF.
# GEMINI_API_KEY=your_ai_studio_api_key_here

# ── Production (ECS Fargate): Vertex AI + Workload Identity Federation ────────
# Authentication uses Application Default Credentials — no API key required.
# The backend task IAM role is federated to Google Cloud via the WIF pool.
VERTEX_PROJECT=fortexa-495604
VERTEX_LOCATION=us-central1

# Path to the external-account credentials config file (workload identity federation).
# Baked into the Docker image at /app/config/gcp-wif.json — do not change on ECS.
# For local Vertex AI access (instead of GEMINI_API_KEY), run:
#   gcloud auth application-default login
# and leave this unset so ambient ADC is used.
GOOGLE_APPLICATION_CREDENTIALS=/app/config/gcp-wif.json

# Gemini Leakage Guardrail (defense-in-depth)
# When 'true', assertNoLeakage() throws if a prompt still contains a URL or IP
# after sanitization. Defaults to ON in non-production (dev/test/CI) to catch
# missing sanitization early, and OFF in production.
# CAVEAT: legitimate URLs exist in ZAP `reference` fields (OWASP doc links) and
# in CSP/Location header values, so enabling it in production can false-positive
# and break report generation. Leave unset in production unless testing.
GEMINI_STRICT_GUARDRAIL=false

# Translation Service
# Uses free Google Translate API (@iamtraction/google-translate)
# No API key required - works out of the box!

# Server Port
PORT=3000

# Frontend URL (React app — used for CORS, email links, Socket.IO)
# Development: http://localhost:3000
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# Node Environment
NODE_ENV=production # Change to 'development' for local testing

# Email — development uses nodemailer (Gmail), production uses AWS SES
# Selection is automatic: NODE_ENV=production → SES, anything else → nodemailer

# nodemailer / Gmail (development)
EMAIL_USER=your_gmail_address_here
EMAIL_PASS=your_gmail_app_password_here

# AWS SES (production)
AWS_REGION=region_name_here
SES_FROM_EMAIL=your_verified_email_in_ses_here

# OWASP ZAP Configuration
# Docker Compose / ECS: use the service name as the hostname.
# Local native (outside Docker): use http://localhost:8080
ZAP_API_URL=http://zap-scanner:8080
# Optional: only needed if your ZAP instance requires an API key (api.disablekey=false)
ZAP_API_KEY=your_zap_api_key_here

# ZAP scan global timeout in milliseconds (default: 12 hours).
# Must be less than your ECS task stop timeout. 43200000 = 12 h.
ZAP_SCAN_TIMEOUT_MS=43200000

# WebCheck Configuration (WebCheck runs on port 3002 in this repo)
# Local dev: use 127.0.0.1 (NOT localhost). IP addresses bypass DNS resolution,
# preventing "queryA ECONNREFUSED localhost" errors from the shared HTTP client's
# DNS cache (cacheable-lookup uses dns.resolve4() which cannot resolve 'localhost').
# Docker / ECS: use the service name (http://webcheck:3002) so Docker DNS resolves it.
WEBCHECK_URI=http://127.0.0.1:3002

# ── DNS caching (cacheable-lookup) ───────────────────────────────────────────
# Fargate tasks hit the VPC Route 53 resolver on every new TCP connection.
# Under concurrent WebCheck load (29 scans × 3 retry attempts) this floods the
# resolver and produces ENOTFOUND / EAI_AGAIN spikes that look like the target
# is unreachable. cacheable-lookup serves repeat lookups from memory instead.
# Value is in SECONDS. 30 s eliminates storm spikes while tracking IP changes.
# ECS Fargate recommended: 30
DNS_CACHE_TTL_SECONDS=30

# ── WebCheck HTTP client (shared axios keep-alive pool) ──────────────────────
# Per-request timeout for individual scan calls (ms). Heavy scans (tls, whois)
# can take 30-60 s. Default 120000 gives room without letting sockets hang.
# ECS Fargate recommended: 120000
WEBCHECK_REQUEST_TIMEOUT_MS=120000

# Timeout for the /health ping to the WebCheck container (ms)
# ECS Fargate recommended: 5000
WEBCHECK_HEALTH_TIMEOUT_MS=5000

# Enable TCP keep-alive on the shared HTTP agent. Critical for ECS Fargate —
# prevents ephemeral port exhaustion by reusing sockets across requests.
# ECS Fargate recommended: true
HTTP_KEEPALIVE=true

# Max open sockets PER HOST in the keep-alive pool.
# ECS tasks have a limited file-descriptor budget; 10 covers all scan concurrency.
# ECS Fargate recommended: 10
HTTP_MAX_SOCKETS=10

# Max idle (free) sockets kept alive per host
# ECS Fargate recommended: 5
HTTP_MAX_FREE_SOCKETS=5

# How long (ms) to hold an idle socket open before closing it
# ECS Fargate recommended: 30000
HTTP_KEEPALIVE_MSECS=30000

# ── WebCheck scan execution ───────────────────────────────────────────────────
# Max simultaneous HTTP calls to the WebCheck container at any one time.
# Raising this speeds up scans but increases socket pressure.
# ECS Fargate recommended: 5 (sweet spot for a single WebCheck container)
WEBCHECK_CONCURRENCY=5

# Split lightweight vs heavy scan pools (backend orchestration)
# Lightweight scans run first at higher concurrency; heavy scans are isolated.
# Defaults: light=WEBCHECK_CONCURRENCY, heavy=floor(WEBCHECK_CONCURRENCY/2)
WEBCHECK_LIGHT_SCAN_CONCURRENCY=5
WEBCHECK_HEAVY_SCAN_CONCURRENCY=2

# Global backpressure (backend): cap concurrently running WebCheck analyses
WEBCHECK_MAX_ACTIVE_SCANS=5

# Optional per-user active WebCheck analyses (0 disables)
WEBCHECK_MAX_ACTIVE_SCANS_PER_USER=0

# Bounded queue size + queue timeout (backend + container)
WEBCHECK_MAX_QUEUE_SIZE=200
WEBCHECK_QUEUE_TIMEOUT_MS=300000

# Hard wall-clock limit per scan type including all retry delays (ms).
# A stalled tls/whois/quality call is aborted after this regardless of retries.
# ECS Fargate recommended: 150000
WEBCHECK_PER_SCAN_TIMEOUT_MS=150000

# Optional per-pool per-scan timeouts (ms)
WEBCHECK_LIGHT_PER_SCAN_TIMEOUT_MS=150000
WEBCHECK_HEAVY_PER_SCAN_TIMEOUT_MS=180000

# Optional global budget for the entire WebCheck analysis (0 disables)
WEBCHECK_GLOBAL_TIMEOUT_MS=0

# Memory pressure protection (backend)
# If heapUsed/heapTotal exceeds this ratio, heavy pool throttles to concurrency=1
WEBCHECK_MEMORY_PRESSURE_HEAP_RATIO=0.85

# ── WebCheck retry policy ─────────────────────────────────────────────────────
# Total attempts (1 original + N-1 retries). Only transient errors are retried
# (ECONNRESET, socket hang up, DNS hiccup, 5xx, rate limit).
# Permanent failures (TLS cert invalid, 4xx, aborted) fail immediately.
# ECS Fargate recommended: 3
WEBCHECK_RETRY_ATTEMPTS=3

# Delay before the first retry (ms)
# ECS Fargate recommended: 1000
WEBCHECK_RETRY_INITIAL_DELAY_MS=1000

# Hard cap on any single retry delay (ms)
# ECS Fargate recommended: 15000
WEBCHECK_RETRY_MAX_DELAY_MS=15000

# Exponential multiplier per retry: delay = initial * factor^(attempt-1)
# ECS Fargate recommended: 2
WEBCHECK_RETRY_BACKOFF_FACTOR=2

# ±fraction of jitter added to each delay to spread concurrent retries.
# 0.3 = ±30%. Prevents thundering herd after a brief WebCheck container restart.
# ECS Fargate recommended: 0.3
WEBCHECK_RETRY_JITTER_FACTOR=0.3

# ── WebCheck per-scan-type circuit breakers ─────────────────────────────────
# If a scan type repeatedly fails (5xx, timeouts, DNS), the breaker opens and
# temporarily rejects NEW requests for that scan type; other scans keep running.
WEBCHECK_CIRCUIT_BREAKER_THRESHOLD=5
WEBCHECK_CIRCUIT_BREAKER_RESET_MS=60000

# ── Storage thresholds ────────────────────────────────────────────────────────
# Results whose JSON size (in MB) exceeds this go to GridFS (not inline MongoDB).
# MongoDB documents are limited to 16 MB; 10 MB is a safe threshold.
WEBCHECK_GRIDFS_THRESHOLD_MB=10

# Wayback Machine can return tens of thousands of entries for old domains.
# Cap them here to prevent unbounded result sizes.
WEBCHECK_MAX_ARCHIVE_ENTRIES=20

# TTL (ms) for the in-memory GridFS result cache.
# Prevents redundant GridFS downloads for the same scan within this window.
WEBCHECK_GRIDFS_CACHE_TTL_MS=60000

# ── BullMQ worker settings ────────────────────────────────────────────────────
# Max simultaneous scan-queue jobs processed by the in-process worker.
# ECS Fargate recommended: 3
WORKER_CONCURRENCY=3

# BullMQ rate limiter: max jobs processed per rate window (prevents burst load).
# ECS Fargate recommended: 10 / 60000
WORKER_RATE_LIMIT_MAX=10
WORKER_RATE_LIMIT_WINDOW_MS=60000

# urlscan.io API Key
# Sign up at urlscan.io and get your API key from Settings & API
URLSCAN_API_KEY=your_urlscan_api_key_here

# Google OAuth Configuration for backend authentication
GOOGLE_CLIENT_ID=your_google_client_id_from_cloud_console

# Rate Limiting Configuration
# Set to 'false' to disable rate limiting in development
RATE_LIMIT_ENABLED=true

# API Rate Limiter (general endpoints)
# Default: 100 requests per 15 minutes (900000ms)
# Development suggestion: 1000 requests per 15 minutes
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=900000

# Auth Rate Limiter (login/register endpoints)
# Default: 20 requests per 15 minutes (900000ms)
# Development suggestion: 100 requests per 15 minutes
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Scan Rate Limiter (file/URL scanning)
# Default: 20 scans per 10 minutes (600000ms)
# Development suggestion: 100 scans per 10 minutes
SCAN_RATE_LIMIT_MAX=20
SCAN_RATE_LIMIT_WINDOW_MS=600000

# Combined Scan Rate Limiter (respects external API limits)
# Default: 1 scan per minute (60000ms)
# Development suggestion: 5 scans per minute
COMBINED_SCAN_RATE_LIMIT_MAX=1
COMBINED_SCAN_RATE_LIMIT_WINDOW_MS=60000

# OWASP ZAP Authenticated Scanning Configuration
# Docker Compose / ECS: use the service name. Local: use http://localhost:8081
ZAP_AUTH_API_URL=http://zap-auth-scanner:8081
# Optional: only needed if your ZAP auth instance requires an API key (api.disablekey=false)
ZAP_AUTH_API_KEY=your_zap_auth_api_key_here

# ─── Stripe Payment Integration ──────────────────────────────────────────────
# REQUIRED to enable billing. If STRIPE_SECRET_KEY is unset, the Stripe routes
# and webhook are NOT mounted (server.js) and checkout/subscription silently
# disabled — set this in every environment that needs payments.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Webhook signing secret (from `stripe listen` or the Dashboard webhook endpoint).
# REQUIRED in production — the webhook hard-fails unsigned events when NODE_ENV=production.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Price IDs — create these products/prices in the Stripe Dashboard.
# All prices below are TAX-EXCLUSIVE amounts (e.g. Light monthly = 30000 JPY).
# Japanese consumption tax is added at checkout via STRIPE_TAX_RATE_ID below.
# Subscriptions (monthly / annual):
STRIPE_PRICE_LIGHT_MONTHLY=price_xxx
STRIPE_PRICE_BASIC_MONTHLY=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_LIGHT_ANNUAL=price_xxx
STRIPE_PRICE_BASIC_ANNUAL=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx
# One-time trial plans:
STRIPE_PRICE_TRIAL1=price_xxx
STRIPE_PRICE_TRIAL2=price_xxx

# Consumption tax rate — REQUIRED. Checkout is refused (503 TAX_NOT_CONFIGURED)
# while this is unset, because the pricing UI quotes a tax-inclusive total and
# taking payment without the rate attached would charge customers less than they
# were shown.
# Create it once in the Stripe Dashboard: Products -> Tax rates -> 10%,
# "Exclusive", region Japan. Then paste the trt_... id here.
# If you change the percentage, also change TAX_RATE in
# frontend/src/pages/Profile.jsx — nothing enforces that they match.
STRIPE_TAX_RATE_ID=trt_xxx

# Redis Configuration (required for BullMQ scan queue + real-time WebSocket progress)
# Redis Cloud (TLS): rediss://<user>:<password>@<host>:<port>
# Local Redis (no TLS): redis://localhost:6379
# Production (AWS ElastiCache): rediss://<primary-endpoint>:6380 (TLS) or
# redis://<primary-endpoint>:6379 (plain)
REDIS_URL=rediss://<user>:<password>@<host>:<port>

# Worker Mode (default: in-process worker runs alongside the server)
# Set to 'true' when deploying a dedicated ECS worker task (node workers/startWorker.js)
DISABLE_WORKER=false

