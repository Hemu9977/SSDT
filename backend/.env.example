# MongoDB Atlas Connection (must use mongodb+srv:// — local MongoDB is not supported)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/virustotal-scanner?retryWrites=true&w=majority

# JWT Secret (generate a random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# PageSpeed Insights API Key
PSI_API_KEY=your_pagespeed_insights_api_key_here

# Gemini Model Configuration
# Change this to switch models (e.g., gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Gemini API Keys for Report Refinement
# Primary API key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback API keys (optional - highly recommended to avoid rate limits)
# Add as many as you want: GEMINI_API_KEY_2, GEMINI_API_KEY_3, etc.
# The system will automatically try the next key if one fails or is overloaded
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here

# Translation Service
# Uses free Google Translate API (@iamtraction/google-translate)
# No API key required - works out of the box!

# Server Port
PORT=3000

# Frontend URL (React app — used for CORS, email links, Socket.IO)
# Development: http://localhost:3000
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# Node Environment
NODE_ENV=production # Change to 'development' for local testing

# Email Configuration for OTP
USE_AWS_SES=true
AWS_REGION=region_name_here
SES_FROM_EMAIL=your_verified_email_in_ses_here

# SendGrid Email Configuration (Required for Invites & Password Reset)
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# Frontend URL (Required for CORS, WebSockets, and Email Links)
CLIENT_URL=http://localhost:3000

# OWASP ZAP Configuration (Docker container runs on localhost:8080)
ZAP_API_URL=http://localhost:8080
# Optional: only needed if your ZAP instance requires an API key (api.disablekey=false)
ZAP_API_KEY=your_zap_api_key_here

# WebCheck Configuration (Docker container runs on localhost:3000)
# Use http://webcheck:3000 if backend runs inside Docker, or http://localhost:3000 if native
WEBCHECK_URI=http://localhost:3000

# urlscan.io API Key
# Sign up at urlscan.io and get your API key from Settings & API
URLSCAN_API_KEY=your_urlscan_api_key_here

# Google OAuth Configuration for backend authentication
GOOGLE_CLIENT_ID=your_google_client_id_from_cloud_console

# Rate Limiting Configuration
# Set to 'false' to disable rate limiting in development
RATE_LIMIT_ENABLED=true

# API Rate Limiter (general endpoints)
# Default: 100 requests per 15 minutes (900000ms)
# Development suggestion: 1000 requests per 15 minutes
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=900000

# Auth Rate Limiter (login/register endpoints)
# Default: 20 requests per 15 minutes (900000ms)
# Development suggestion: 100 requests per 15 minutes
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Scan Rate Limiter (file/URL scanning)
# Default: 20 scans per 10 minutes (600000ms)
# Development suggestion: 100 scans per 10 minutes
SCAN_RATE_LIMIT_MAX=20
SCAN_RATE_LIMIT_WINDOW_MS=600000

# Combined Scan Rate Limiter (respects external API limits)
# Default: 1 scan per minute (60000ms)
# Development suggestion: 5 scans per minute
COMBINED_SCAN_RATE_LIMIT_MAX=1
COMBINED_SCAN_RATE_LIMIT_WINDOW_MS=60000

# OWASP ZAP Authenticated Scanning Configuration (Docker container runs on localhost:8081)
ZAP_AUTH_API_URL=http://localhost:8081
# Optional: only needed if your ZAP auth instance requires an API key (api.disablekey=false)
ZAP_AUTH_API_KEY=your_zap_auth_api_key_here

