{
  "family": "zap-auth-task",
  "requiresCompatibilities": [
    "EC2"
  ],
  "networkMode": "awsvpc",
  "cpu": "3072",
  "memory": "14336",
  "executionRoleArn": "arn:aws:iam::459181228792:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "zap-auth-scanner",
      "image": "ghcr.io/zaproxy/zaproxy@sha256:781a2bdaea47324e7bab583e2263f21d257b0aee61ed51521a5be45f5f5081ef",
      "essential": true,
      "cpu": 2048,
      "memory": 14080,
      "memoryReservation": 14080,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "name": "zap-auth-8080-tcp",
          "appProtocol": "http"
        }
      ],
      "entryPoint": [
        "sh",
        "-c"
      ],
      "command": [
        "mkdir -p /home/zap/.ZAP && printf -- '-Xms2g -Xmx11g\n' > /home/zap/.ZAP/.ZAP_JVM.properties && exec zap.sh -daemon -silent -host 0.0.0.0 -port 8080 -config api.key=\"$ZAP_API_KEY\" -config api.addrs.addr.name=.* -config api.addrs.addr.regex=true"
      ],
      "environment": [],
      "stopTimeout": 30,
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f -H \"X-ZAP-API-Key: $ZAP_API_KEY\" http://localhost:8080/JSON/core/view/version/ || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/zap-auth-task",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "secrets": [
        {
          "name": "ZAP_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:459181228792:secret:fortexa-backend-secrets-NxEnZI:ZAP_AUTH_API_KEY::"
        }
      ]
    }
  ],
  "taskRoleArn": "arn:aws:iam::459181228792:role/fortexa-zap-task-role"
}
