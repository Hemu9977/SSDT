# Refreshes TLS material and ACL hashes from Secrets Manager. Pulled in (Wants=) by
# valkey.service, so it re-runs before every Valkey start: rotating the certificate or
# a password is "update the secret, restart valkey".
[Unit]
Description=Fetch Fortexa Valkey TLS material and ACL from Secrets Manager
After=network-online.target
Wants=network-online.target
Before=valkey.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fortexa-valkey-secrets
TimeoutStartSec=360

[Install]
WantedBy=multi-user.target
