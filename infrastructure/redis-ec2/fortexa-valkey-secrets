#!/usr/bin/python3
"""Install Fortexa Valkey TLS material and ACL users from Secrets Manager.

Runs as root before every valkey.service start (fortexa-valkey-secrets.service), so
rotating the certificate or a password is: update the secret, restart Valkey.

Secret `fortexa-redis/host` (JSON):
  server_crt, server_key, ca_crt           PEM strings
  app_sha256                               SHA-256 hex of the fortexa-app password
  app_sha256_next                          optional second hash (zero-downtime rotation)
  admin_sha256, admin_password             ops-admin user (localhost / SSM use only)

Writes atomically and never prints secret material.
"""
import json
import os
import pwd
import re
import subprocess
import sys
import tempfile
import time

ENV_FILE = '/etc/fortexa/redis.env'
TLS_DIR = '/etc/valkey/tls'
ACL_TEMPLATE = '/etc/valkey/users.acl.tmpl'
ACL_FILE = '/etc/valkey/users.acl'
ADMIN_PASS_FILE = '/etc/valkey/ops-admin.pass'


def load_env():
    env = {}
    with open(ENV_FILE) as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith('#') and '=' in line:
                k, v = line.split('=', 1)
                env[k.strip()] = v.strip()
    return env


def write_atomic(path, data, mode, uid, gid):
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix='.tmp-')
    try:
        with os.fdopen(fd, 'w') as f:
            f.write(data)
        os.chmod(tmp, mode)
        os.chown(tmp, uid, gid)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def fetch_secret(env, attempts=30, delay=10):
    """At boot the NAT route or instance credentials can lag a few seconds; retry
    for ~5 minutes. Valkey does not wait on this (Wants=, not Requires=), so a
    slow fetch only delays a rotation, never availability."""
    last = ''
    for i in range(attempts):
        out = subprocess.run(
            ['aws', 'secretsmanager', 'get-secret-value',
             '--region', env['REGION'], '--secret-id', env['HOST_SECRET_ID'],
             '--query', 'SecretString', '--output', 'text'],
            capture_output=True, text=True)
        if out.returncode == 0:
            return json.loads(out.stdout)
        last = out.stderr.strip().splitlines()[-1:] or ['']
        time.sleep(delay)
    sys.exit(f'could not read {env["HOST_SECRET_ID"]}: {last[0]}')


def main():
    env = load_env()
    s = fetch_secret(env)

    hex64 = re.compile(r'^[0-9a-f]{64}$')
    for k in ('app_sha256', 'admin_sha256'):
        if not hex64.match(s.get(k, '')):
            sys.exit(f'secret field {k} is missing or not a SHA-256 hex digest')
    for k in ('server_crt', 'server_key', 'ca_crt'):
        if 'BEGIN' not in s.get(k, ''):
            sys.exit(f'secret field {k} is missing or not PEM')

    vk = pwd.getpwnam('valkey')
    os.makedirs(TLS_DIR, mode=0o750, exist_ok=True)
    os.chown(TLS_DIR, 0, vk.pw_gid)
    write_atomic(f'{TLS_DIR}/server.crt', s['server_crt'], 0o644, 0, vk.pw_gid)
    write_atomic(f'{TLS_DIR}/ca.crt', s['ca_crt'], 0o644, 0, vk.pw_gid)
    write_atomic(f'{TLS_DIR}/server.key', s['server_key'], 0o640, 0, vk.pw_gid)

    app_hashes = '#' + s['app_sha256']
    nxt = s.get('app_sha256_next') or ''
    if nxt:
        if not hex64.match(nxt):
            sys.exit('secret field app_sha256_next is not a SHA-256 hex digest')
        app_hashes += ' #' + nxt
    with open(ACL_TEMPLATE) as f:
        acl = f.read()
    acl = acl.replace('#__APP_SHA256__', app_hashes).replace('__ADMIN_SHA256__', s['admin_sha256'])
    if '__' in acl:
        sys.exit('ACL template still has unrendered placeholders')
    write_atomic(ACL_FILE, acl, 0o640, 0, vk.pw_gid)

    # Root-only: used by the metrics script and by operators over SSM.
    write_atomic(ADMIN_PASS_FILE, s.get('admin_password', ''), 0o600, 0, 0)
    print('fortexa-valkey-secrets: TLS material and ACL installed')


if __name__ == '__main__':
    main()
