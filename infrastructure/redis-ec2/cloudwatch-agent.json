{
  "agent": { "metrics_collection_interval": 60, "run_as_user": "root" },
  "metrics": {
    "namespace": "Fortexa/Redis",
    "append_dimensions": { "InstanceId": "${aws:InstanceId}" },
    "aggregation_dimensions": [["InstanceId"]],
    "metrics_collected": {
      "mem":  { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"], "drop_device": true }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/log/valkey/valkey.log", "log_group_name": "/ec2/fortexa-redis",
            "log_stream_name": "{instance_id}/valkey", "retention_in_days": 30 },
          { "file_path": "/var/log/fortexa-redis-bootstrap.log", "log_group_name": "/ec2/fortexa-redis",
            "log_stream_name": "{instance_id}/bootstrap", "retention_in_days": 30 }
        ]
      }
    }
  }
}
